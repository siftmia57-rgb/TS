<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>TS QUANTUM V2.4.7 — AI Trading Signal Engine</title>
  
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts: Orbitron & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Orbitron:wght@500;600;700;800;900&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-deep: #110303;
      --bg-maroon: #1f0606;
      --card-bg: rgba(42, 9, 9, 0.72);
      --card-inset: rgba(24, 4, 4, 0.85);
      --border-red: rgba(255, 65, 65, 0.24);
      --border-red-bright: rgba(255, 65, 65, 0.55);
      --neon-red: #ff3333;
      --neon-green: #00e676;
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      margin: 0;
      padding: 0;
      font-family: 'Inter', sans-serif;
      background-color: #0b0101;
      background-image: 
        radial-gradient(circle at 50% 0%, rgba(160, 15, 15, 0.28) 0%, transparent 55%),
        radial-gradient(circle at 50% 100%, rgba(120, 10, 10, 0.22) 0%, transparent 55%);
      color: #ffffff;
      min-height: 100vh;
      overflow-x: hidden;
    }

    .font-orbitron {
      font-family: 'Orbitron', sans-serif;
    }

    /* App Container mimicking native mobile viewport cleanly on desktop & full width on mobile */
    .app-shell {
      width: 100%;
      max-width: 480px;
      min-height: 100vh;
      margin: 0 auto;
      background: linear-gradient(180deg, #190404 0%, #120303 45%, #180404 100%);
      position: relative;
      box-shadow: 0 0 60px rgba(0, 0, 0, 0.9), 0 0 25px rgba(255, 30, 30, 0.08);
      border-left: 1px solid rgba(255, 50, 50, 0.08);
      border-right: 1px solid rgba(255, 50, 50, 0.08);
    }

    /* Glassmorphic Crimson Cards */
    .quantum-card {
      background: var(--card-bg);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid var(--border-red);
      border-radius: 18px;
      box-shadow: 0 8px 28px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 100, 100, 0.08);
      transition: transform 0.18s ease, border-color 0.2s ease, background 0.2s ease;
    }

    .quantum-card-interactive:active {
      transform: scale(0.985);
      border-color: var(--border-red-bright);
    }

    .quantum-inset {
      background: var(--card-inset);
      border: 1px solid rgba(255, 65, 65, 0.2);
      border-radius: 13px;
    }

    /* Primary Gradient Button */
    .btn-quantum-red {
      background: linear-gradient(180deg, #ff4b4b 0%, #e02424 100%);
      box-shadow: 0 4px 20px rgba(255, 45, 45, 0.4), inset 0 1px 1px rgba(255, 255, 255, 0.25);
      border: 1px solid rgba(255, 110, 110, 0.4);
      color: #ffffff;
      transition: all 0.2s ease;
    }
    .btn-quantum-red:hover {
      filter: brightness(1.06);
    }
    .btn-quantum-red:active {
      transform: scale(0.98);
    }

    /* Pair Pill Buttons */
    .pair-pill {
      background: rgba(45, 9, 9, 0.78);
      border: 1px solid rgba(255, 65, 65, 0.24);
      border-radius: 12px;
      transition: all 0.16s ease;
    }
    .pair-pill:hover {
      border-color: rgba(255, 75, 75, 0.6);
      background: rgba(65, 13, 13, 0.9);
    }
    .pair-pill:active {
      transform: scale(0.97);
    }

    /* Glowing Cyber Emblem Animation */
    @keyframes pulseGlow {
      0%, 100% { filter: drop-shadow(0 0 14px rgba(255, 40, 40, 0.55)); }
      50% { filter: drop-shadow(0 0 26px rgba(255, 60, 60, 0.85)); }
    }
    .logo-glow {
      animation: pulseGlow 3s infinite ease-in-out;
    }

    @keyframes spinSlow {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    .spin-slow {
      animation: spinSlow 24s linear infinite;
    }

    /* Laser Scan Line for Screenshot AI Analysis */
    @keyframes scanLaser {
      0% { top: 4%; opacity: 0.4; }
      50% { top: 92%; opacity: 1; }
      100% { top: 4%; opacity: 0.4; }
    }
    .laser-line {
      position: absolute;
      left: 0;
      right: 0;
      height: 3px;
      background: linear-gradient(90deg, transparent, #ff3333, #ffffff, #ff3333, transparent);
      box-shadow: 0 0 15px 3px rgba(255, 45, 45, 0.85);
      animation: scanLaser 2s ease-in-out infinite;
    }

    /* Error Shake */
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      20%, 60% { transform: translateX(-6px); }
      40%, 80% { transform: translateX(6px); }
    }
    .animate-shake {
      animation: shake 0.35s ease-in-out;
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 4px;
    }
    ::-webkit-scrollbar-track {
      background: #120303;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(255, 60, 60, 0.3);
      border-radius: 99px;
    }
  </style>
</head>
